# Copiar como ".env" dentro de backend/ y completar. Nunca subir el .env real.

# --- Asistente conversacional (Google Gemini API) ---
GEMINI_API_KEY=TU_API_KEY
GEMINI_MODEL=gemini-3.5-flash-lite

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Opcionales ---
# GEMINI_MAX_OUTPUT_TOKENS=2048
# GEMINI_TIMEOUT_SEGUNDOS=30
# MAX_TOOL_ITERATIONS=6
# MAX_MENSAJES_HISTORIAL=12
# UMBRAL_POCAS_CELDAS=5
# SQLITE_DB_PATH=data/chat_history.db
